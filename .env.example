# FILE: .env.example — Every environment variable this project reads (Build Spec Section 12).
# Copy to .env.local for local dev, and paste the same keys into
# Vercel → Settings → Environment Variables (Production + Preview + Development).
# NEVER commit .env.local.

# ===== SECTION: SUPABASE =====
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY          # server only — bypasses RLS, never expose
SUPABASE_ANON_KEY=YOUR_ANON_KEY                          # server-side copy (used to verify admin logins)

# Client bundle needs these two for Supabase Auth sign-in on /admin.
# The anon key has ZERO table permissions under RLS — it can only authenticate.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ===== SECTION: QR SECURITY =====
# Any long random string. Generate with:  openssl rand -hex 32
QR_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ===== SECTION: EMAIL (RESEND) =====
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM="PIID Summit <tickets@your-verified-domain.com>"

# ===== SECTION: ADMIN EXPORT =====
# Long random string; gates /api/admin/export (organizer-level, separate from showroom logins)
ADMIN_EXPORT_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# ===== SECTION: EVENT DETAILS (used in the ticket email) =====
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
NEXT_PUBLIC_EVENT_NAME="PIID Summit"
EVENT_NAME="PIID Summit — New Worlds"
EVENT_DATE="Saturday, 15 November 2026 · 9:00 AM"
EVENT_VENUE="SMX Convention Center, Pasay City"
